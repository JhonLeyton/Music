---
import Layout from '../layouts/Layout.astro';

const concepto = {
  nombre: '🎼 Armonía',

  descripcion:
    'La armonía combina múltiples notas simultáneamente para crear acordes y profundidad sonora.',

  patron: `note("[c3,e3,g3]").sound("piano")`,

  notas: [
    'c3 = Do',
    'e3 = Mi',
    'g3 = Sol',
    'Acorde Do Mayor'
  ]
};
---

<Layout title={concepto.nombre}>

<section class="top">

<div>

<h1>{concepto.nombre}</h1>

<p>{concepto.descripcion}</p>

</div>

<div class="music-circle">
🎼
</div>

</section>

<div class="card">

<h2>Acorde Armónico</h2>

<pre>
<code>{concepto.patron}</code>
</pre>

<ul>
  {concepto.notas.map((n) => (
    <li>{n}</li>
  ))}
</ul>

</div>

<div class="card">

<h2>🎵 Harmony Live Editor</h2>

<p>
Experimenta con acordes y capas musicales futuristas.
</p>

<iframe
  src="https://strudel.cc/?embed=1"
  style="width:100%; height:600px; border:none;"
  allow="autoplay"
  title="Harmony Editor">
</iframe>

</div>

<style>

.top{

  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:2rem;

  margin-bottom:3rem;

  flex-wrap:wrap;
}

.music-circle{

  width:140px;
  height:140px;

  border-radius:50%;

  display:flex;
  justify-content:center;
  align-items:center;

  font-size:4rem;

  background:
    linear-gradient(
      135deg,
      rgba(34,211,238,0.18),
      rgba(192,132,252,0.18)
    );

  box-shadow:
    0 0 40px rgba(34,211,238,0.25);

  animation:pulse 3s infinite;
}

@keyframes pulse{

  0%{
    transform:scale(1);
  }

  50%{
    transform:scale(1.08);
  }

  100%{
    transform:scale(1);
  }

}

</style>

</Layout>