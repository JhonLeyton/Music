---
const { title } = Astro.props;
---

<html lang="es">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width" />

<title>{title}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{

  font-family:'Rajdhani', sans-serif;

  background:
    radial-gradient(circle at top left,
    #111827 0%,
    #020617 45%,
    #000000 100%);

  color:white;

  min-height:100vh;

  overflow-x:hidden;
}

/* ===== SCROLL ===== */

::-webkit-scrollbar{
  width:10px;
}

::-webkit-scrollbar-track{
  background:#020617;
}

::-webkit-scrollbar-thumb{

  background:
    linear-gradient(
      #22d3ee,
      #9333ea
    );

  border-radius:20px;
}

/* ===== GLOW ===== */

.background-glow{

  position:fixed;

  width:1000px;
  height:1000px;

  background:
    radial-gradient(circle,
    rgba(34,211,238,0.18) 0%,
    rgba(192,132,252,0.14) 35%,
    transparent 70%);

  top:-300px;
  left:-300px;

  z-index:-1;

  animation:floatGlow 15s ease-in-out infinite;
}

@keyframes floatGlow{

  0%{
    transform:translate(0,0);
  }

  50%{
    transform:translate(180px,120px);
  }

  100%{
    transform:translate(0,0);
  }

}

/* ===== NAVBAR ===== */

nav{

  position:sticky;
  top:0;

  z-index:999;

  display:flex;
  align-items:center;
  gap:1rem;

  padding:1.2rem 2rem;

  background:rgba(2,6,23,0.65);

  backdrop-filter:blur(14px);

  border-bottom:
    1px solid rgba(255,255,255,0.08);
}

.logo{

  margin-right:auto;

  font-family:'Orbitron', sans-serif;

  font-size:1.3rem;

  font-weight:800;

  color:#67e8f9;

  letter-spacing:2px;

  text-shadow:
    0 0 10px #67e8f9,
    0 0 25px #67e8f9;

  animation:pulseLogo 3s infinite;
}

@keyframes pulseLogo{

  0%{
    text-shadow:
      0 0 10px #67e8f9,
      0 0 25px #67e8f9;
  }

  50%{
    text-shadow:
      0 0 20px #67e8f9,
      0 0 40px #67e8f9;
  }

  100%{
    text-shadow:
      0 0 10px #67e8f9,
      0 0 25px #67e8f9;
  }

}

nav a{

  color:#cbd5e1;

  text-decoration:none;

  padding:0.8rem 1.3rem;

  border-radius:14px;

  font-weight:600;

  transition:0.35s;
}

nav a:hover{

  color:white;

  background:
    linear-gradient(
      135deg,
      rgba(34,211,238,0.2),
      rgba(192,132,252,0.2)
    );

  transform:translateY(-2px);

  box-shadow:
    0 0 15px rgba(34,211,238,0.3);
}

/* ===== CONTAINER ===== */

.container{

  max-width:1250px;

  margin:auto;

  padding:3rem 2rem;
}

/* ===== TITLES ===== */

h1{

  font-family:'Orbitron', sans-serif;

  font-size:4.5rem;

  margin-bottom:1.5rem;

  line-height:1.1;

  color:#67e8f9;

  text-shadow:
    0 0 15px #67e8f9,
    0 0 35px #67e8f9;

  animation:fadeUp 1s ease;
}

h2{

  font-family:'Orbitron', sans-serif;

  color:#c084fc;

  margin-bottom:1rem;

  letter-spacing:1px;
}

@keyframes fadeUp{

  from{
    opacity:0;
    transform:translateY(30px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }

}

p{

  line-height:1.9;

  font-size:1.1rem;

  color:#cbd5e1;
}

/* ===== CARDS ===== */

.card{

  position:relative;

  overflow:hidden;

  background:
    linear-gradient(
      145deg,
      rgba(15,23,42,0.88),
      rgba(30,41,59,0.72)
    );

  border:
    1px solid rgba(255,255,255,0.08);

  backdrop-filter:blur(16px);

  border-radius:28px;

  padding:2rem;

  transition:0.4s;

  box-shadow:
    0 10px 35px rgba(0,0,0,0.35);
}

.card:hover{

  transform:
    translateY(-10px)
    scale(1.02);

  box-shadow:
    0 0 35px rgba(34,211,238,0.25);
}

.card::before{

  content:"";

  position:absolute;

  width:100%;
  height:4px;

  background:
    linear-gradient(
      90deg,
      #22d3ee,
      #c084fc,
      #67e8f9
    );

  top:0;
  left:0;
}

/* ===== BUTTONS ===== */

.btn{

  display:inline-block;

  margin-top:1.5rem;

  padding:1rem 1.6rem;

  border-radius:16px;

  text-decoration:none;

  font-weight:700;

  letter-spacing:1px;

  color:white;

  background:
    linear-gradient(
      135deg,
      #06b6d4,
      #9333ea
    );

  transition:0.35s;

  box-shadow:
    0 0 20px rgba(34,211,238,0.35);
}

.btn:hover{

  transform:
    translateY(-4px)
    scale(1.03);

  box-shadow:
    0 0 40px rgba(192,132,252,0.45);
}

/* ===== FOOTER ===== */

footer{

  text-align:center;

  padding:3rem 2rem;

  color:#64748b;

  border-top:
    1px solid rgba(255,255,255,0.08);

  margin-top:4rem;
}

/* ===== RESPONSIVE ===== */

@media(max-width:768px){

  h1{
    font-size:3rem;
  }

  nav{
    flex-wrap:wrap;
  }

}

</style>

</head>

<body>

<div class="background-glow"></div>

<nav>

<div class="logo">
🎵 MUSIC PLAYGROUND
</div>

<a href="/">Inicio</a>

<a href="/ritmo">Ritmo</a>

<a href="/melodia">Melodía</a>

<a href="/armonia">Armonía</a>

</nav>

<div class="container">

<slot />

</div>

<footer>

<p>
⚡ Astro - JhonDc
</p>

</footer>

</body>

</html>